{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noImplicitAny": false,
        "noEmit": true,
        // @types/three references @webgpu/types, which conflicts with the WebGPU
        // types built into TypeScript 6's own lib.dom
        "skipLibCheck": true,
        "paths": {
            "pixi.js": ["../src/index.ts"],
            "pixi.js/*": ["../src/*"],
            "~/*": ["../src/*"]
        }
    },
    "include": [".", "../types", "../src/**/*.d.ts", "../src/**/__docs__/examples"],
}
